@echo off
setlocal
cd /d "%~dp0"

rem RecursiveUnpacker.spec is GENERATED by this script - do not hand-edit it.
rem Artifact: dist\RecursiveUnpacker.exe (onefile, windowed, with Windows version resource).

set "PYTHON=python"
where py >nul 2>nul && set "PYTHON=py -3"

%PYTHON% -m pip install -r requirements.txt pyinstaller
if errorlevel 1 (
  echo Dependency installation failed.
  pause
  exit /b 1
)

if not exist "version_info.txt" (
  echo version_info.txt is missing in %CD%.
  echo The executable would ship without Windows version information.
  pause
  exit /b 1
)

%PYTHON% -m PyInstaller --noconfirm --clean --onefile --windowed --name RecursiveUnpacker --version-file "version_info.txt" --collect-all py7zr --collect-all pyzipper main.py
if errorlevel 1 (
  echo Build failed.
  echo If dist\RecursiveUnpacker.exe is running or locked by antivirus, close it and retry.
  pause
  exit /b 1
)

if not exist "dist\RecursiveUnpacker.exe" (
  echo Build reported success but dist\RecursiveUnpacker.exe is missing.
  pause
  exit /b 1
)

echo Built executable: dist\RecursiveUnpacker.exe
pause
endlocal
